<html>
    <head>
        <title>Create New User</title>
        <%- include('partials/header1.ejs') %>
    </head>
    <body>
        <%- include('partials/navbarAdmin.ejs') %>
        <div class="container"><br>
            <h1><strong>Create New User</strong></h1>
            
            <% if (error) { %>
                <p style="color: red;"><%= error %></p>
            <% } %>
            
            <form method="post" action="/adminRegisterUser">
                <label><strong>Full Name:</strong></label>
                <input type="text" name="name" required /><br><br>
                
                <label><strong>Email:</strong></label>
                <input type="email" name="email" required />
                
                <label><strong>Phone Number:</strong></label>
                <input type="tel" name="phone_number" required /><br><br>
                
                <p style="background-color: #fffacd; padding: 10px; width: 50%; border-radius: 5px;">
                <em><strong>Default password:</strong> Welcome123</em><br>
                <em>User can change password after first login</em>
                </p>

                <button type="submit" class="btn-success"><strong>Create User</strong></button>
                <a href="/adminAllUsers"><button type="button" class="btn-danger"><strong>Cancel</strong></button></a>
            </form>
        </div>
    </body>
    <footer>
        <p>&copy; 2026 Jun Healthcare House. All rights reserved.</p>
    </footer>
</html>