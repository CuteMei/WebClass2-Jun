<html>
    <head>
        <title>JHH login-page</title>
        <%- include('partials/header1.ejs') %>
    </head>
    <body>
        <%- include('partials/navbarPublic.ejs') %>
        <div class="container"><br>
            <h1><strong>Login</strong></h1><br>

            <!-- ADD THESE MESSAGE BLOCKS! -->
            <% if (typeof error !== 'undefined' && error) { %>
                <p style="color: red; font-weight: bold;"> <%= error %></p>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <p style="color: green; font-weight: bold;"> <%= success %></p>
            <% } %>
            <!-- END OF MESSAGE BLOCKS -->

            <form action="/auth" method="post">
                <label><strong>Your Email:</strong></label>
                <input type="email" name="email" placeholder="Enter Email" required /><br><br>
                <label><strong>Your Password:</strong></label>
                <input type="password" name="password" placeholder="Enter Password" required/><br><br>
                <button type="submit" class="btn-success"><strong>Login</strong></button>
            </form>
            <p>Don't have an account? Go to <a href="register">Register</a> first please?<br>
                Forgot your password? Contact us at <a href="mailto:JunHealthcareHouse@gmail.com">
				JunHealthcareHouse@gmail.com</a> to reset it.</p><br><br>
            <p></p>
        </div>
    </body>
    <footer>
        <p>&copy; 2026 Jun Healthcare House. All rights reserved.</p>
    </footer>
</html>