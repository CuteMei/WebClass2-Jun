<html>
    <head>
        <title>JHH All Users</title>
        <%- include('partials/header1.ejs') %>
    </head>
    <body>
        <%- include('partials/navbarAdmin.ejs') %>
        <div class="container">
            <br><h1><strong>All Users</strong></h1>
            
            <% if (contactsData.length === 0) { %>
                <p>No users registered yet.</p>
            <% } else { %>
            
            <a href="/adminCreateUser">
                <button type="button" class="btn-success"><strong>+ Create New User</strong></button>
            </a><br><br>
     
            <table>
                <tr>
                    <th>No.</th>
                    <th>User ID</th>
                    <th>Name</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>

                <% let i = 1;
                   contactsData.forEach(function(data) { %>                
                <tr>
                    <td><%= i++ %></td>
                    <td><%= data.user_id %></td>
                    <td><%= data.name %></td>
                    <td><%= data.phone_number %></td>
                    <td><%= data.email %></td>
                    <td>
                        <a href="/adminEditUser?userId=<%= data.user_id %>">
                            <button type="submit" class="btn-primary"><strong>Edit</strong></button>
                        </a>
                    </td>
                </tr>                    
                <% }); %>
            </table>
            <% } %>
        </div>
    </body><br><br>
    <footer>
        <p>&copy; 2026 Jun Healthcare House. All rights reserved.</p>
    </footer>
</html>