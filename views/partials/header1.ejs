<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet"> 
<link rel="stylesheet" href="/public/css/styles.css">
<style>
    .welcome-header {
        text-align: center;
        padding: 10px;
    }
    .welcome-header img {
        height: 40px;
        vertical-align: middle;
        margin: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    
    table th {
        background-color: #4A90E2;
        color: white;
        padding: 12px;
        text-align: left;
        font-weight: bold;
    }
    
    table td {
        padding: 10px;
        border: 1px solid #ddd;
    }
    
    table tr:nth-child(even) {
        background-color: #d0e6fb;
    }
    
    table tr:hover {
        background-color: #f0f0f0;
    }
    
    /* Default button style */
    button {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        font-weight: bold;
    }

    /* Primary button (Submit/Save/Create) - Blue or Green */
    button[type="submit"] {
        background-color: #4CAF50;  /* Green */
        color: white;
    }

    button[type="submit"]:hover {
        background-color: #45a049;
    }

    /* Secondary button (Cancel/Back) - Red */
    button[type="button"] {
        background-color: #dc3545;  /* Red */
        color: white;
    }

    button[type="button"]:hover {
        background-color: #c82333;
    }

    /* Or use classes for more control */
    .btn-success {
        background-color: #4CAF50;  /* Green */
        color: white;
    }

    .btn-danger {
        background-color: #dc3545;  /* Red */
        color: white;
    }

    .btn-primary {
        background-color: #007bff;  /* Blue */
        color: white;
    }
</style>