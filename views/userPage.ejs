<html>
    <head>
        <title>JHH User Page</title>
        <%- include('partials/header1.ejs') %>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    </head>
    <body>
        <%- include('partials/navbarUser.ejs') %>
        <div class="container"><br>
            <h1><strong>Welcome <%=name %> to book your Appointment</strong></h1><br>
                        
            <form method="post" action="/userCreateBooking">
                <input type="hidden" name="user_id" value="<%= user_id %>" />

                <label><strong>Your Name:</strong></label>
                <input type="text" name="name" value="<%= name %>" readonly style="background-color: #f0f0f0;" disabled />
                
                <label><strong>Your Phone:</strong></label>
                <input type="text" value="<%= phone || 'Please update in profile' %>" readonly style="background-color: #f0f0f0;" /><br><br>
                
                <label><strong>Appointment Date:</strong></label>
                <input type="text" name="date" id="dateInput" placeholder="Select Date" required readonly />
                
                <label><strong>Appointment Time:</strong></label>
                <select name="time" id="timeSelect" required>
                    <option value="" disabled selected>--Select Time--</option>
                    <option value="09:30">09:30</option>
                    <option value="11:00">11:00</option>
			        <option value="13:00">13:00</option>
			        <option value="14:30">14:30</option>
			        <option value="16:00">16:00</option>
                </select><br><br>
                
                <label><strong>Notes (Optional):</strong></label><br>
                <textarea name="notes" rows="3" cols="50" placeholder="requirements"></textarea><br><br>
                
                <button type="submit" class="btn-success"><strong>Book Appointment</strong></button>
            </form>
            <p id="bookingSuccess" style="color: green; display: none">Booking submitted successfully!</p>
        </div>
    
        <!-- Flatpickr JS -->
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script>
            const minDate = new Date();
            minDate.setHours(minDate.getHours() + 48);
            const maxDate = new Date();
            maxDate.setDate(maxDate.getDate() + 30);

            flatpickr('#dateInput', {
                minDate: minDate,
                maxDate: maxDate,
                disable: [
                    function(date) {
                    // Block Wednesday (3), Saturday (6), Sunday (0)
                    return [0, 3, 6].includes(date.getDay());
                }],
                dateFormat: 'Y-m-d', // sends date as YYYY-MM-DD to backend
                onChange: function(selectedDates, dateStr) {
                    if (dateStr) {
                        fetchAvailableSlots(dateStr);
                    }
                }
            });

            // Fetch available time slots
            async function fetchAvailableSlots(date) {
                try {
                    const response = await fetch(`/available-slots?date=${date}`);
                    const data = await response.json();
                    
                    const timeSelect = document.getElementById('timeSelect');
                    const allSlots = [
                        { value: '09:30', label: '09:30' },
                        { value: '11:00', label: '11:00' },
                        { value: '13:00', label: '13:00' },
                        { value: '14:30', label: '14:30' },
                        { value: '16:00', label: '16:00' }
                    ];

                    // Clear and rebuild options
                    timeSelect.innerHTML = '<option value="" disabled selected>--Select Time--</option>';
                    
                    allSlots.forEach(slot => {
                        const option = document.createElement('option');
                        option.value = slot.value;
                        option.textContent = slot.label;
                        
                        // Check if this time is booked
                        if (data.bookedSlots.includes(slot.value)) {
                            option.disabled = true;
                            option.textContent += ' (Booked)';
                            option.style.color = '#999';
                        }
                        
                        timeSelect.appendChild(option);
                    });
                } catch (error) {
                    console.error('Error fetching slots:', error);
                }
            };
            
        </script>
    </body><br><br><br>
    <footer>
        <p>&copy; 2026 Jun Healthcare House. All rights reserved.</p>
    </footer>
</html>